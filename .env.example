# Copy this file to `.env` for local development. Never commit `.env`.

DJANGO_DEBUG=True

# Leave empty locally (a dev-only key is used when DEBUG is True).
# In production, set a long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated, no spaces needed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only, e.g. https://taka-koi-gelo.onrender.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# Copy this file to `.env` for local development. Never commit `.env`.

DJANGO_DEBUG=True

# Leave empty locally (a dev-only key is used when DEBUG is True).
# In production, set a long random value, e.g. from:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated, no spaces needed.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Production only, e.g. https://taka-koi-gelo.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local: the Docker database from docker-compose.yml (run `docker compose up -d`).
# Production: Supabase transaction pooler URL (port 6543), set in Vercel, never committed.
DATABASE_URL=postgres://takakoigelo:takakoigelo-local@127.0.0.1:5433/takakoigelo

# Production: set to True (Supabase requires SSL). Leave False locally.
DB_SSL_REQUIRE=False

# Seconds to keep a DB connection open between requests. Keep 0 with a pooler.
DB_CONN_MAX_AGE=0

# Production only: random secret Vercel Cron sends as "Authorization: Bearer <value>".
# Generate one the same way as DJANGO_SECRET_KEY.
CRON_SECRET=
